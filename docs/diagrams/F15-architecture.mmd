graph TD
    subgraph Admin["Admin Panel (index.html)"]
        UI_UPLOAD["Upload Video (MP4)"]
        UI_PREVIEW["Video Preview"]
        UI_DELETE["Delete Video"]
    end

    subgraph Server["Admin Server (server.ts)"]
        EP_POST["POST /api/collections/:slug/video"]
        EP_DELETE["DELETE /api/collections/:slug/video"]
        VALIDATE["Validate MP4 + size <= 50MB"]
        PERSIST["gitPersist()"]
    end

    subgraph Data["Data Layer"]
        JSON["collections.json<br/>videoUrl field"]
        VIDEOS["public/videos/decks/<br/>slug.mp4"]
    end

    subgraph Frontend["Landing Page"]
        DETAIL["colecoes.$slug.tsx"]
        PLAYER["HTML5 Video Player<br/>controls, no autoplay"]
    end

    UI_UPLOAD -->|FormData| EP_POST
    UI_DELETE -->|DELETE| EP_DELETE
    EP_POST --> VALIDATE
    VALIDATE -->|OK| VIDEOS
    VALIDATE -->|OK| JSON
    EP_POST --> PERSIST
    EP_DELETE --> JSON
    EP_DELETE -->|unlinkSync| VIDEOS
    EP_DELETE --> PERSIST
    JSON -->|build| DETAIL
    DETAIL -->|videoUrl != ""| PLAYER
    VIDEOS -->|static serve| PLAYER
    EP_POST -->|200 path| UI_PREVIEW
