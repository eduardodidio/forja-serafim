# Google OAuth — required for admin authentication
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated list of authorized admin emails
ALLOWED_EMAILS=email1@example.com,email2@example.com

# GitHub PAT with repo scope — used for git push from admin panel
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Render deploy hook URL — triggers static site rebuild after publish
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-xxxxx?key=xxxxx
